#ifndef CONFIG_H_EXAMPLE
#define CONFIG_H_EXAMPLE

/**
 * ============================================================================
 * Configuration Template for ESP32 Firmware
 * Copy this file to src/config.h and update with your network credentials.
 * ============================================================================
 */

// Wi-Fi Credentials
#define WIFI_SSID                  "Your_WiFi_SSID"
#define WIFI_PASSWORD              "Your_WiFi_Password"
#define WIFI_CONNECT_TIMEOUT_MS    15000
#define WIFI_RECONNECT_INTERVAL_MS 5000

// Device Identity & Hierarchy
#define PROPERTY_ID                "prop_demo_001"
#define ZONE_ID                    "zone_kitchen_01"
#define DEVICE_ID                  "ESP32_A1B2C3"
#define DEVICE_TOKEN               "token_a1b2c3d4e5"
#define FIRMWARE_VERSION           "1.0.0"

// MQTT Broker Configuration
#define MQTT_BROKER_HOST           "192.168.1.100"
#define MQTT_BROKER_PORT           1883
#define MQTT_USERNAME              "esp32_node"
#define MQTT_PASSWORD              "node_secret_key"
#define MQTT_CLIENT_ID             "ESP32_A1B2C3"
#define MQTT_KEEP_ALIVE_SEC        30
#define MQTT_SOCKET_TIMEOUT_SEC    5
#define MQTT_RECONNECT_INTERVAL_MS 4000

// HTTP Fallback API (used if MQTT is unreachable)
#define HTTP_BACKEND_BASE_URL      "http://192.168.1.100:5000"
#define HTTP_TELEMETRY_ENDPOINT    "/api/telemetry/ingest"
#define HTTP_ALERT_ENDPOINT        "/api/incidents/ingest"
#define HTTP_REQUEST_TIMEOUT_MS    6000

// Reporting Timing & Intervals
#define TELEMETRY_INTERVAL_MS      15000   // 15 seconds default
#define SENSOR_SAMPLE_INTERVAL_MS  2000    // Sample sensors every 2s for local monitoring
#define SENSOR_DEBOUNCE_TIME_MS    1500    // Minimum time between repeated hazard alerts

// Hazard Thresholds (Default local safety limits)
#define FLAME_THRESHOLD_PCT        30.0f   // Flame IR intensity threshold (%)
#define GAS_THRESHOLD_PPM          200.0f  // MQ-2 combustible gas / LPG threshold (PPM)
#define SMOKE_THRESHOLD_PPM        300.0f  // MQ-2 smoke warning threshold (PPM)
#define WATER_THRESHOLD_PCT        20.0f   // Water probe wetness threshold (%)
#define TEMP_HIGH_THRESHOLD_C      50.0f   // Critical high temperature alarm
#define TEMP_LOW_THRESHOLD_C       3.0f    // Freezing pipe risk alarm

// MQ-2 Calibration Parameters
#define MQ2_RL_VALUE               5.0f    // Load resistance on the board in kOhms
#define MQ2_RO_CLEAN_AIR_FACTOR    9.83f   // Rs/Ro ratio in clean air
#define MQ2_DEFAULT_RO             10.0f   // Calibrated Ro in kOhms (can be dynamically calibrated)

// NTP Time Synchronization
#define NTP_SERVER                 "pool.ntp.org"
#define GMT_OFFSET_SEC             0       // Offset in seconds (e.g. 0 for UTC, 3600 for CET)
#define DAYLIGHT_OFFSET_SEC        0

#endif // CONFIG_H_EXAMPLE
