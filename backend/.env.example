PORT=5000
NODE_ENV=development

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/property_risk_db?schema=public

# MQTT Broker Configuration
# External broker URL (e.g. mosquitto container)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_CLIENT_ID=property-risk-backend
# Set to 'true' to always run the embedded Aedes MQTT broker inside the backend service
EMBEDDED_MQTT=true

# JWT Authentication (replace with a unique random secret of 32+ characters in production)
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# CORS (comma-separated allowed origins)
CLIENT_URL=http://localhost:5173

# Optional Firebase Admin service account JSON for hazard push delivery.
# Keep the real service account private; never commit it to the repository.
FIREBASE_SERVICE_ACCOUNT_JSON=
