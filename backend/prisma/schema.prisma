datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  PROPERTY_OWNER
  AUTHORIZED_DELEGATE
  // Legacy values retained so existing installations can migrate without
  // removing data. They do not grant administrative or ownership rights.
  MANAGER
  VIEWER
}

enum ArmingState {
  DISARMED
  ARMED_HOME
  ARMED_AWAY
}

enum HazardType {
  SMOKE
  FLAME
  GAS_LEAK
  WATER_LEAK
  HIGH_TEMP
  LOW_TEMP
  MOTION
  DEVICE_OFFLINE
}

enum IncidentSeverity {
  INFO
  WARNING
  CRITICAL
}

enum IncidentStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

model User {
  id             String        @id @default(uuid())
  email          String        @unique
  passwordHash   String
  name           String
  role           Role          @default(PROPERTY_OWNER)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  properties     Property[]    @relation("PropertyMembers")
  ownedProperties Property[]   @relation("PropertyOwner")
  incidentsAck   Incident[]    @relation("AcknowledgedBy")
  pushTokens     PushToken[]
}

model Property {
  id          String        @id @default(uuid())
  name        String
  address     String?
  armingState ArmingState   @default(DISARMED)
  ownerId     String?
  owner       User?         @relation("PropertyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  users       User[]        @relation("PropertyMembers")
  zones       Zone[]
  incidents   Incident[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([ownerId])
}

model Zone {
  id              String        @id @default(uuid())
  propertyId      String
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name            String
  devices         Device[]
  thresholdConfig Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Device {
  id          String        @id
  name        String
  zoneId      String
  zone        Zone          @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  deviceToken String        @unique
  isOnline    Boolean       @default(false)
  lastSeenAt  DateTime?
  firmwareVer String?
  readings    TelemetryReading[]
  incidents   Incident[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

/// An administrator provisions a device once. The QR pairing secret is stored
/// as a hash and consumed atomically when an owner claims the device.
model DeviceEnrollment {
  deviceId       String   @id
  name           String
  deviceToken    String   @unique
  pairingTokenHash String @unique
  firmwareVer    String?
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  claimedAt      DateTime?
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, enabled])
}

model TelemetryReading {
  id             BigInt        @id @default(autoincrement())
  deviceId       String
  device         Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  recordedAt     DateTime      @default(now())
  temperature    Float?
  humidity       Float?
  smokePpm       Float?
  gasPpm         Float?
  flameDetected  Boolean       @default(false)
  waterDetected  Boolean       @default(false)
  motionDetected Boolean       @default(false)
  wifiRssi       Int?

  @@index([deviceId, recordedAt(sort: Desc)])
  @@index([recordedAt(sort: Desc)])
}

model TelemetryRollup {
  id           BigInt        @id @default(autoincrement())
  deviceId     String
  bucketStart  DateTime
  avgTemp      Float?
  minTemp      Float?
  maxTemp      Float?
  avgHumidity  Float?
  avgSmokePpm  Float?
  maxSmokePpm  Float?
  avgGasPpm    Float?
  maxGasPpm    Float?
  flameEvents  Int           @default(0)
  waterEvents  Int           @default(0)
  motionEvents Int           @default(0)

  @@unique([deviceId, bucketStart])
  @@index([bucketStart(sort: Desc)])
}

model Incident {
  id             String           @id @default(uuid())
  propertyId     String
  property       Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  deviceId       String
  device         Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  hazardType     HazardType
  severity       IncidentSeverity
  status         IncidentStatus   @default(ACTIVE)
  readingValue   Float?
  details        String?
  startedAt      DateTime         @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?
  userAck        User?            @relation("AcknowledgedBy", fields: [acknowledgedBy], references: [id])
  resolvedAt     DateTime?

  @@index([propertyId, status])
  @@index([startedAt(sort: Desc)])
}
