# Root Environment Variables
NODE_ENV=development
PORT=5000

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=property_risk_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/property_risk_db?schema=public

# MQTT Broker Configuration
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_CLIENT_ID=property-risk-backend

# JWT Secrets & Security (replace with a unique random secret of 32+ characters in production)
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d

# CORS Configuration (comma-separated allowed origins)
CLIENT_URL=http://localhost:5173

# Optional Firebase Admin service account JSON for FCM push delivery.
FIREBASE_SERVICE_ACCOUNT_JSON=
